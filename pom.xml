<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.github.rk.apps</groupId>
	<artifactId>pocket-watch</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>pocket-watch</name>
	<description>Date/Time library with annotation-based validation and
		operations</description>
	<!-- FIXME change it to the project's website -->
	<url>https://github.com/kenduraghav/pocket-watch</url>
	
	
	<modules>
        <module>pocket-watch-core</module>
        <module>pocket-watch-annotations</module>
        <module>pocket-watch-validator</module>
        <module>pocket-watch-processor</module>
    </modules>

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<junit.version>5.10.0</junit.version>
		<slf4j.version>2.0.9</slf4j.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Internal modules -->
			<dependency>
				<groupId>com.pocketwatch</groupId>
				<artifactId>pocket-watch-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.pocketwatch</groupId>
				<artifactId>pocket-watch-annotations</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.pocketwatch</groupId>
				<artifactId>pocket-watch-validator</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Testing -->
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>

			<!-- Logging -->
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-api</artifactId>
				<version>${slf4j.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Compiler Plugin -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.14.0</version>
					<configuration>
						<release>${java.version}</release>
					</configuration>
				</plugin>

				<!-- Surefire (Test) Plugin -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.2.5</version>
				</plugin>

				<!-- Source Plugin -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.3.0</version>
					<executions>
						<execution>
							<id>attach-sources</id>
							<goals>
								<goal>jar</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!-- Javadoc Plugin -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>3.6.3</version>
					<executions>
						<execution>
							<id>attach-javadocs</id>
							<goals>
								<goal>jar</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- Developers -->
	<developers>
		<developer>
			<id>kenduraghav</id>
			<name>Raghav</name>
			<url>https://github.com/kenduraghav</url>
		</developer>
	</developers>

	<!-- SCM -->
	<scm>
		<connection>scm:git:git://github.com/kenduraghav/pocket-watch.git</connection>
		<developerConnection>
			scm:git:ssh://github.com/kenduraghav/pocket-watch.git</developerConnection>
		<url>https://github.com/kenduraghav/pocket-watch</url>
	</scm>

	<!-- License -->
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<reporting>
		<plugins>
			<plugin>
				<artifactId>maven-project-info-reports-plugin</artifactId>
			</plugin>
		</plugins>
	</reporting>
</project>
